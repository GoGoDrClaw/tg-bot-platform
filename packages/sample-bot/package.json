{
  "name": "@bot-platform/sample-bot",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc -b"
  },
  "keywords": ["telegram", "bot"],
  "dependencies": {
    "@nikovonlas/bot-sdk": "^1.1.0",
    "grammy": "^1.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "bot": {
    "type": "telegram",
    "env": {
      "DEBUG": {
        "required": false,
        "description": "Enable debug logging (true/false)",
        "default": "false",
        "configKey": "debug"
      },
      "LANGUAGE": {
        "required": false,
        "description": "Bot language (en-US, ru-RU)",
        "default": "en-US",
        "configKey": "language"
      },
      "WELCOME_MESSAGE": {
        "required": false,
        "description": "Custom welcome message for /start command",
        "default": "",
        "configKey": "welcomeMessage"
      }
    },
    "os-packages": []
  }
}
