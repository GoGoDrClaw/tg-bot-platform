FROM node:18-bullseye

WORKDIR /app

ARG OS_PACKAGES=""
RUN if [ -n "$OS_PACKAGES" ]; then apt-get update && apt-get install -y $OS_PACKAGES && rm -rf /var/lib/apt/lists/*; fi

COPY package*.json ./
RUN npm install

COPY . .
RUN mkdir -p /bot-platform
COPY tsconfig.base.json /bot-platform/tsconfig.base.json
RUN npm install express
RUN npm run build || npm run build --if-present
RUN npm prune --omit=dev

COPY runtime-server.js ./runtime-server.js

# Create directory for SQLite database
RUN mkdir -p /app/data

ENV PORT=3000
ENV BOT_ID=""
EXPOSE $PORT

CMD ["node", "runtime-server.js"]
