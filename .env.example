API_PORT=3000
API_HOST=0.0.0.0
WEBHOOK_BASE_URL=http://bot-manager:3000/w
LOG_LEVEL=debug
DB_HOST=postgres
DB_PORT=5432
DB_USER=bot
DB_PASSWORD=bot
DB_NAME=bot-platform
DB_URL=postgres://bot:bot@postgres:5432/bot-platform
TELEGRAM_API_BASE=http://bot-api:8081
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=none
RUNTIME_VERSION=1.2.0

# Authentication (IMPORTANT: Change these in production!)
# Generate a secure JWT secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-use-at-least-32-characters
# Create a bot via @BotFather and paste its token here for Telegram Login Widget
TELEGRAM_WIDGET_BOT_TOKEN=YOUR_BOT_TOKEN_FOR_WIDGET