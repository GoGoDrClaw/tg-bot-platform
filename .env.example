# ============================================================================
# Bot Platform - Environment Configuration
# ============================================================================
# Copy this file to .env and configure your values
# SECURITY: Never commit .env to git - it's in .gitignore

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================

# Port for the Bot Manager API
# Default: 3000
API_PORT=3000

# Host to bind the API server
# 0.0.0.0 = listen on all interfaces (Docker/production)
# 127.0.0.1 = localhost only (development)
API_HOST=0.0.0.0

# Base URL for webhooks (used by Telegram to send updates)
# Docker Compose: http://bot-manager:3000/w
# Production: https://yourdomain.com/w
WEBHOOK_BASE_URL=http://bot-manager:3000/w

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database type selection
# Options: postgres, sqlite
# Default: sqlite (if not specified)
#
# SQLite - Good for:
#   ✅ Small deployments (1-10 bots)
#   ✅ Single server setup
#   ✅ Easy backup (just copy .sqlite file)
#   ✅ No extra dependencies
#
# PostgreSQL - Good for:
#   ✅ Large deployments (10+ bots)
#   ✅ Multiple server instances
#   ✅ Advanced queries and performance
#   ✅ Production-grade reliability
DB_TYPE=sqlite

# SQLite Configuration (used when DB_TYPE=sqlite)
# Path to SQLite database file
# Default: storage/data.sqlite
# SQLITE_PATH=storage/data.sqlite

# PostgreSQL Configuration (used when DB_TYPE=postgres)
# Connection details for PostgreSQL server
DB_HOST=postgres
DB_PORT=5432
DB_USER=bot
DB_PASSWORD=bot
DB_NAME=bot-platform

# Full database connection URL (PostgreSQL)
# Format: postgres://user:password@host:port/database
# This is used when DB_TYPE=postgres
DB_URL=postgres://bot:bot@postgres:5432/bot-platform

# ============================================================================
# TELEGRAM API CONFIGURATION
# ============================================================================

# Telegram Bot API server URL
# Default: http://bot-api:8081 (local Bot API server)
# Official: https://api.telegram.org (not recommended for self-hosted)
TELEGRAM_API_BASE=http://bot-api:8081

# Telegram API credentials (optional, for local Bot API server)
# Get these from https://my.telegram.org/apps
# Leave as 0/none if using official API
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=none

# ============================================================================
# BOT RUNTIME CONFIGURATION
# ============================================================================

# Runtime version for bot containers
# Controls which base image is used for bot deployment
# Default: 1.2.5
RUNTIME_VERSION=1.2.5

# Runtime port (internal container port)
# Default: 8080
# Note: This is auto-configured, usually don't need to change
RUNTIME_PORT=8080

# Status reconciliation interval (seconds)
# How often to check bot statuses from Docker/K8s
# Default: 20
STATUS_RECONCILE_SEC=20

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Secret for authentication tokens
# ⚠️  CRITICAL: Change this in production!
# Generate with: openssl rand -base64 32
# Must be at least 32 characters long
JWT_SECRET=your-super-secret-jwt-key-change-in-production-use-at-least-32-characters

# Telegram Login Widget Bot Token
# 1. Create a bot via @BotFather: /newbot
# 2. Set domain: /setdomain -> yourdomain.com
# 3. Paste the bot token here
# 4. Update packages/web-ui/login.html with your bot username
TELEGRAM_WIDGET_BOT_TOKEN=YOUR_BOT_TOKEN_FOR_WIDGET

# Development Mode - Bypass Authentication
# ⚠️  WARNING: Only for local development! Never enable in production!
# When enabled, shows "Dev Login" button that bypasses Telegram authentication
# Automatically disabled if NODE_ENV=production or request is not from localhost
# DEV_BYPASS_AUTH=true

# Dev user configuration (used when DEV_BYPASS_AUTH=true)
# Customize these to match your Telegram account for testing
# DEV_USER_TELEGRAM_ID=123456789
# DEV_USER_USERNAME=devuser
# DEV_USER_FIRST_NAME=Dev
# DEV_USER_LAST_NAME=User

# ============================================================================
# LOGGING
# ============================================================================

# Log level for application logs
# Options: debug, info, warn, error
# Development: debug
# Production: info or warn
LOG_LEVEL=debug

# ============================================================================
# OPTIONAL: DEPLOYMENT SETTINGS
# ============================================================================

# Node environment
# development = uses SQLite, detailed logs
# production = uses PostgreSQL, minimal logs
# NODE_ENV=production